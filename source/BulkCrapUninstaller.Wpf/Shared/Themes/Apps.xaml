<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:apps="clr-namespace:BulkCrapUninstaller.Wpf.Features.Apps"
  xmlns:hc="https://handyorg.github.io/handycontrol">

  <!--
    The application list: a lean DataGrid (no grid lines, rounded rows) and the small marks
    that replace the WinForms row colors (verified, unverified, invalid, orphan, feature, store).
  -->

  <!--  Thin bar at the start of the row, colored by AppItem.Status  -->
  <Style x:Key="StatusMark" TargetType="Border">
    <Setter Property="Width" Value="3" />
    <Setter Property="Height" Value="16" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="Transparent" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static apps:AppStatus.Verified}">
        <Setter Property="Background" Value="{DynamicResource Status.VerifiedBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static apps:AppStatus.Unverified}">
        <Setter Property="Background" Value="{DynamicResource Status.UnverifiedBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static apps:AppStatus.Invalid}">
        <Setter Property="Background" Value="{DynamicResource Status.InvalidBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static apps:AppStatus.Orphan}">
        <Setter Property="Background" Value="{DynamicResource Status.OrphanBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static apps:AppStatus.Feature}">
        <Setter Property="Background" Value="{DynamicResource Status.FeatureBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static apps:AppStatus.Store}">
        <Setter Property="Background" Value="{DynamicResource Status.StoreBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!--  Legend dot  -->
  <Style x:Key="LegendDot" TargetType="Ellipse">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style
    x:Key="LegendText"
    BasedOn="{StaticResource TextBlockCaption}"
    TargetType="TextBlock">
    <Setter Property="Margin" Value="0,0,16,0" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.XS}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <!--  Soft tag in the details pane: 64-BIT, STARTUP...  -->
  <Style x:Key="Tag" TargetType="Border">
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="Padding" Value="7,2,7,3" />
    <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}" />
    <Setter Property="TextElement.FontSize" Value="{StaticResource FontSize.XS}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource SecondaryTextBrush}" />
  </Style>

  <!--  Chip of the active quick view over the list, with an X  -->
  <Style x:Key="FilterChip" TargetType="Border">
    <Setter Property="Height" Value="{StaticResource Control.Height}" />
    <Setter Property="Padding" Value="10,0,4,0" />
    <Setter Property="Background" Value="{DynamicResource Accent.SoftBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="TextElement.FontSize" Value="{StaticResource FontSize.Sm}" />
  </Style>

  <!--  Segmented choice: a recessed bar with the picked segment raised  -->
  <Style x:Key="SegmentBar" TargetType="Border">
    <Setter Property="Height" Value="{StaticResource Control.Height}" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}" />
  </Style>

  <Style x:Key="Segment" TargetType="ToggleButton">
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border
            x:Name="Bd"
            Padding="{TemplateBinding Padding}"
            Background="Transparent"
            CornerRadius="3">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RegionBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  ===== DATAGRID: HandyControl's own look, only tuned  =====  -->
  <Style
    x:Key="AppGrid"
    BasedOn="{StaticResource DataGridBaseStyle}"
    TargetType="DataGrid">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
    <Setter Property="RowHeight" Value="34" />
    <Setter Property="GridLinesVisibility" Value="None" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="SelectionMode" Value="Extended" />
    <Setter Property="SelectionUnit" Value="FullRow" />
    <Setter Property="AutoGenerateColumns" Value="False" />
    <Setter Property="CanUserAddRows" Value="False" />
    <Setter Property="CanUserDeleteRows" Value="False" />
    <Setter Property="CanUserResizeRows" Value="False" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="EnableRowVirtualization" Value="True" />
    <Setter Property="EnableColumnVirtualization" Value="True" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
  </Style>

  <!--  Label/value pair in the details pane  -->
  <Style x:Key="DetailLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSize.XS}" />
    <Setter Property="Foreground" Value="{DynamicResource ThirdlyTextBrush}" />
    <Setter Property="Margin" Value="0,10,0,2" />
  </Style>

  <Style x:Key="DetailValue" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style
    x:Key="DetailMono"
    BasedOn="{StaticResource DetailValue}"
    TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.XS}" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
  </Style>

</ResourceDictionary>
