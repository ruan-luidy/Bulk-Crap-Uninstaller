<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:BulkCrapUninstaller.Wpf.Shared.Controls">

  <!--
    Option pages: MasonryPanel of OptionPanels (card with a small header and one OptionRow per option).
    The label has the same width on every row, so the fields line up.
  -->

  <Style TargetType="controls:OptionPanel">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:OptionPanel">
          <Border Padding="14,10,14,12" Style="{StaticResource Card}">
            <DockPanel>
              <DockPanel Margin="0,0,0,8" DockPanel.Dock="Top">
                <ContentPresenter
                  VerticalAlignment="Center"
                  Content="{TemplateBinding Aside}"
                  DockPanel.Dock="Right" />
                <Path
                  Margin="0,0,8,0"
                  Data="{TemplateBinding Icon}"
                  Fill="{DynamicResource PrimaryBrush}"
                  Style="{StaticResource Icon.Small}" />
                <ContentPresenter
                  VerticalAlignment="Center"
                  ContentSource="Header"
                  TextElement.FontSize="{StaticResource FontSize.XS}"
                  TextElement.FontWeight="SemiBold"
                  TextElement.Foreground="{DynamicResource SecondaryTextBrush}" />
              </DockPanel>
              <ContentPresenter />
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="controls:OptionRow">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:OptionRow">
          <Grid MinHeight="34" Margin="0,1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="{Binding LabelWidth, RelativeSource={RelativeSource TemplatedParent}}" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
              <TextBlock
                x:Name="Label"
                FontSize="{StaticResource FontSize.Sm}"
                Foreground="{DynamicResource SecondaryTextBrush}"
                Text="{TemplateBinding Label}"
                TextTrimming="CharacterEllipsis" />
              <TextBlock
                x:Name="Caption"
                Margin="0,1,0,0"
                FontSize="{StaticResource FontSize.XS}"
                Foreground="{DynamicResource ThirdlyTextBrush}"
                Text="{TemplateBinding Caption}"
                TextWrapping="Wrap" />
            </StackPanel>
            <ContentPresenter
              Grid.Column="1"
              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
              VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Caption" Value="{x:Null}">
              <Setter TargetName="Caption" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Label" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="OptionPages" TargetType="controls:MasonryPanel">
    <Setter Property="Margin" Value="0,14,0,4" />
    <Setter Property="MinColumnWidth" Value="320" />
    <Setter Property="MaxColumns" Value="3" />
    <Setter Property="Spacing" Value="12" />
    <Setter Property="LevelColumns" Value="True" />
  </Style>

  <Style x:Key="PanelDivider" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,6" />
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
  </Style>

  <Style
    x:Key="PanelNote"
    BasedOn="{StaticResource TextBlockCaption}"
    TargetType="TextBlock">
    <Setter Property="Margin" Value="0,4,0,2" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.XS}" />
  </Style>

  <Style
    x:Key="OptionSwitch"
    BasedOn="{StaticResource ToggleButtonSwitch.Small}"
    TargetType="ToggleButton">
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style
    x:Key="SliderValue"
    BasedOn="{StaticResource TextBox.Small}"
    TargetType="TextBox">
    <Setter Property="Width" Value="52" />
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <Style
    x:Key="OptionSlider"
    BasedOn="{StaticResource {x:Type Slider}}"
    TargetType="Slider">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="IsMoveToPointEnabled" Value="True" />
    <Setter Property="IsSnapToTickEnabled" Value="True" />
  </Style>

  <!--  Path kept by the app: read only, small font  -->
  <Style
    x:Key="PathField"
    BasedOn="{StaticResource TextBox.Small}"
    TargetType="TextBox">
    <Setter Property="FontSize" Value="{StaticResource FontSize.XS}" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="IsReadOnlyCaretVisible" Value="False" />
  </Style>

</ResourceDictionary>
